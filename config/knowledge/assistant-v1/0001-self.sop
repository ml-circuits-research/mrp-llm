# assistant-v1: the assistant and its memory, as knowledge (questions about "you", "your memory", "what do you know", "what can you do"
# are ordinary questions about the entity mrp_llm). The formalizer writes the name "MRP-LLM" for the assistant. The statistics of a
# memory (entity_count, relation_fact_count, memory_size, memory_layer) are generated by tools/assistant/memory-statistics.mjs into the
# memory that imports this layer; knows_about (core-en, roles subject and topic) is derived from them.

@software_assistant entity
  kind class
  label en "software assistant"
  alias en "chatbot"
  alias en "AI assistant"

# In a chat the user calls the assistant "you": the alias is how the user names this entity (data of the memory, like any alias).
@mrp_llm entity
  kind software_assistant
  label en "MRP-LLM"
  alias en "you"
  alias en "yourself"

@can_do predicate
  args subject:entity object:text
  role subject entity
  role object text
  label en "can do"
  description "Something the subject (the assistant) can do for its user, as a short text."

@entity_count predicate
  args subject:entity object:integer
  role subject class
  role object integer
  label en "number of entities in memory"
  description "The assistant's memory holds this many entities (object) whose class is the subject; generated from the memory's statistics."

@relation_fact_count predicate
  args subject:text object:integer
  role subject text
  role object integer
  label en "number of facts of a relation in memory"
  description "The assistant's memory stores this many facts (object) of the relation named by the subject; generated from the memory's statistics."

@memory_size predicate
  args subject:text object:integer
  role subject text
  role object integer
  label en "size of the memory"
  description "The assistant's memory holds this many items (object) of the kind named by the subject (facts, entities, relations, classes, knowledge files, SOP wires); generated from the memory's statistics."

@memory_layer predicate
  args subject:entity object:text
  role subject entity
  role object text
  label en "has memory layer"
  description "The memory of the subject (the assistant) is built from the knowledge layer named by the object; generated from the memory's manifest."

@as_knows_about rule
  when entity_count ?c ?n
  when compare ?n at_least 150
  then knows_about mrp_llm ?c
  source "assistant-v1: a class with at least 150 entities in the memory is a topic the assistant knows about"

# What the assistant can do is also what it is capable of (the common-sense relation capable_of of commonsense-v1, when present).
@as_capable rule
  when can_do ?a ?t
  then capable_of ?a ?t
  source "assistant-v1: an ability of the assistant is a capability"

@as_f1 fact
  holds is_a mrp_llm software_assistant
@as_f2 fact
  holds description mrp_llm "a question-answering assistant that answers from a symbolic memory of facts and rules, shows the facts and sources it used, and says when it does not know"
@as_f3 fact
  holds can_do mrp_llm "answer questions from its memory, showing the facts and sources it used"
@as_f4 fact
  holds can_do mrp_llm "count, compare and rank things it knows about"
@as_f5 fact
  holds can_do mrp_llm "give examples or a random fact from its memory"
@as_f6 fact
  holds can_do mrp_llm "use what you tell it during a conversation"
@as_f7 fact
  holds can_do mrp_llm "describe its own memory: what it holds and how much"
@as_f8 fact
  holds named mrp_llm "MRP-LLM"

@lx_can_do_en lexeme
  of can_do
  language en
  pos verb
  form "can do"
  form "be capable of doing"
  frame subject object
  restrict subject software_assistant
  source "assistant-v1"

@lx_entity_count_en lexeme
  of entity_count
  language en
  pos verb
  form "count entities in memory"
  form "have entities in memory"
  frame subject object
  source "assistant-v1"

@lx_relation_fact_count_en lexeme
  of relation_fact_count
  language en
  pos verb
  form "count facts in memory"
  form "have facts in memory"
  frame subject object
  source "assistant-v1"

@lx_memory_size_en lexeme
  of memory_size
  language en
  pos verb
  form "count in memory"
  form "be the size of the memory"
  frame subject object
  source "assistant-v1"

@lx_memory_layer_en lexeme
  of memory_layer
  language en
  pos verb
  form "have memory layer"
  form "be built from"
  frame subject object
  source "assistant-v1"
