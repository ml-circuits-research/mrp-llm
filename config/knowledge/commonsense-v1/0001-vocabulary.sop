# ---- geography (derived from located_in, capital_of and the class of the container) -----------------------------------------------

@on_continent predicate
  args subject:entity location:entity
  role subject entity
  role location continent
  label en "on continent"
  description "The subject (a place, organization or anything located somewhere) is on the given continent. Derived from located_in and the class continent."

@lx_on_continent_en_copula lexeme
  of on_continent
  language en
  pos copula
  form "be on the continent of"
  frame subject location
  source "authored (commonsense-agent)"

@in_country predicate
  args subject:entity location:entity
  role subject entity
  role location country
  label en "in country"
  description "The subject (a city, region, building, organization) is in the given country. Derived from located_in and the class country."

@lx_in_country_en_copula lexeme
  of in_country
  language en
  pos copula
  form "be in the country"
  frame subject location
  source "authored (commonsense-agent)"

@same_country_as predicate
  args subject:entity object:entity
  role subject entity
  role object entity
  label en "in the same country as"
  description "Both are in the same country. Derived from in_country."

@lx_same_country_as_en_copula lexeme
  of same_country_as
  language en
  pos copula
  form "be in the same country as"
  frame subject object
  source "authored (commonsense-agent)"

@same_continent_as predicate
  args subject:entity object:entity
  role subject entity
  role object entity
  label en "on the same continent as"
  description "Both are on the same continent. Derived from on_continent."

@lx_same_continent_as_en_copula lexeme
  of same_continent_as
  language en
  pos copula
  form "be on the same continent as"
  frame subject object
  source "authored (commonsense-agent)"

# ---- quantities and units -------------------------------------------------------------------------------------------------------

@dimension entity
  kind class
  label en "physical dimension"
  alias en "dimension"
  alias en "quantity kind"
  source "authored (commonsense-agent)"

@mass entity
  kind dimension
  label en "mass"
  alias en "weight"
  source "authored (commonsense-agent)"

@length entity
  kind dimension
  label en "length"
  alias en "distance"
  source "authored (commonsense-agent)"

@duration_dimension entity
  kind dimension
  label en "duration"
  alias en "time span"
  source "authored (commonsense-agent)"

@volume entity
  kind dimension
  label en "volume"
  alias en "capacity"
  source "authored (commonsense-agent)"

@surface_area entity
  kind dimension
  label en "surface area"
  source "authored (commonsense-agent)"

@dimension_of predicate
  args subject:entity object:entity
  role subject unit
  role object dimension
  label en "dimension of"
  reading unit_dimension
  description "The physical dimension a unit measures (mass, length, duration, volume, area); quantities can be compared only within one dimension."

@base_amount predicate
  args subject:entity object:integer
  role subject unit
  role object integer
  label en "amount in base units"
  reading unit_amount
  description "One of the unit equals this whole number of the fine base unit of its dimension: milligrams for mass, micrometres for length, milliseconds for duration, microlitres for volume, square millimetres for area (imperial units rounded to the nearest base unit). Comparing 1 kg with 900 g: 1 x 1000000 mg against 900 x 1000 mg."

@same_dimension predicate
  args subject:entity object:entity
  role subject unit
  role object unit
  label en "same dimension"
  description "Two units measure the same dimension, so their quantities can be converted and compared. Derived from dimension_of."

@converts_to predicate
  args subject:entity topic:entity object:integer
  role subject unit
  role topic unit
  role object integer
  label en "converts to"
  description "One of the subject unit is exactly this whole number of the topic unit (for example 1 kilogram is 1000 grams); derived from base_amount when the ratio is whole."
