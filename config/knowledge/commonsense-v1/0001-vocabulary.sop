# commonsense-v1: the vocabulary of the common-sense layer (hand-written by commonsense-agent, 2026-10-02).
# The predicates that the layer's rules derive and that its source-derived facts use (WordNet, ConceptNet, units), with their English
# lexemes. English only. Everything else the layer uses is declared by core-min and core-en, which this layer imports and never redeclares.
# Class-level facts ("used_for violin ...") are about the kind: a class symbol (kind class) in the subject position stands for a typical
# member of the class. Provenance of every fact is its `source` line; the layer's own rules carry `source "authored ..."`.

# ---- class-level common sense (ConceptNet, WordNet) -----------------------------------------------------------------------------

@used_for predicate
  args subject:entity object:text
  role subject entity
  role object text
  label en "used for"
  description "Things of the subject's kind are typically used for the activity named by the object (class-level common sense, for example a hammer is used for driving nails)."

@lx_used_for_en_copula lexeme
  of used_for
  language en
  pos copula
  form "be used for"
  form "be used to"
  form "be good for"
  frame subject object
  source "authored (commonsense-agent): ConceptNet UsedFor"

@capable_of predicate
  args subject:entity object:text
  role subject entity
  role object text
  label en "can"
  description "Things of the subject's kind are typically able to do the activity named by the object (class-level common sense, for example a dog can bark)."

@lx_capable_of_en_verb lexeme
  of capable_of
  language en
  pos verb
  form "be able to"
  form "be capable of"
  frame subject object
  source "authored (commonsense-agent): ConceptNet CapableOf"

@typical_property predicate
  args subject:entity object:text
  role subject entity
  role object text
  label en "is typically"
  description "Things of the subject's kind typically have the quality named by the object (class-level common sense, for example ice is cold)."

@lx_typical_property_en_copula lexeme
  of typical_property
  language en
  pos copula
  form "be typically"
  form "be usually"
  form "tend to be"
  frame subject object
  weight 5
  source "authored (commonsense-agent): ConceptNet HasProperty"

@found_at predicate
  args subject:entity location:entity
  role subject entity
  role location entity
  label en "typically found at"
  description "Things of the subject's kind are typically found at or kept in places of the location's kind (class-level common sense, for example a pillow is found in a bedroom)."

@lx_found_at_en_copula lexeme
  of found_at
  language en
  pos copula
  form "be found at"
  form "be usually kept in"
  form "be typically found in"
  frame subject location
  source "authored (commonsense-agent): ConceptNet AtLocation"

@typically_has predicate
  args subject:entity object:entity
  role subject entity
  role object entity
  label en "typically has"
  description "Things of the subject's kind typically have a thing of the object's kind (class-level common sense, for example a bird has wings)."

@lx_typically_has_en_verb lexeme
  of typically_has
  language en
  pos verb
  form "usually have"
  form "typically have"
  frame subject object
  weight 4
  source "authored (commonsense-agent): ConceptNet HasA"

@made_of_material predicate
  args subject:entity object:entity
  role subject entity
  role object entity
  label en "made of the material"
  description "Things of the subject's kind are made of, or contain as a substance, the material or substance named by the object (class-level, for example glass windows, water contains oxygen); core-en made_of is the instance-level relation of an artifact."

@lx_made_of_material_en_copula lexeme
  of made_of_material
  language en
  pos copula
  form "be made from"
  form "contain the substance"
  frame subject object
  source "authored (commonsense-agent): WordNet substance meronym, ConceptNet MadeOf"

@disjoint_with predicate
  args subject:entity object:entity
  role subject class
  role object class
  label en "disjoint with"
  description "No entity belongs to both classes (for example nothing is both a person and a place). Symmetric."

@lx_disjoint_with_en_copula lexeme
  of disjoint_with
  language en
  pos copula
  form "be disjoint with"
  frame subject object
  source "authored (commonsense-agent)"

# ---- time and lifetimes (derived from born_on / died_on years) --------------------------------------------------------------------

@older_than predicate
  args subject:entity object:entity
  role subject person
  role object person
  label en "older than"
  description "The subject was born in an earlier year than the object. Derived from the birth years (born_on), never stated."

@lx_older_than_en_copula lexeme
  of older_than
  language en
  pos copula
  form "be older than"
  form "be born before"
  frame subject object
  source "authored (commonsense-agent)"

@younger_than predicate
  args subject:entity object:entity
  role subject person
  role object person
  label en "younger than"
  description "The subject was born in a later year than the object. Derived from the birth years (born_on), never stated."

@lx_younger_than_en_copula lexeme
  of younger_than
  language en
  pos copula
  form "be younger than"
  form "be born after"
  frame subject object
  source "authored (commonsense-agent)"

@contemporary_of predicate
  args subject:entity object:entity
  role subject person
  role object person
  label en "contemporary of"
  description "The lifetimes of the two persons overlapped (each was born before the other died), so they could have met; refuted when one died before the other was born. Derived from born_on and died_on years."

@lx_contemporary_of_en_copula lexeme
  of contemporary_of
  language en
  pos copula
  form "be a contemporary of"
  form "be alive at the same time as"
  form "live at the same time as"
  form "could have met"
  frame subject object
  source "authored (commonsense-agent)"

@lived_before predicate
  args subject:entity object:entity
  role subject person
  role object person
  label en "lived before"
  description "The subject died before the object was born: their lifetimes did not overlap. Derived from died_on and born_on years."

@lx_lived_before_en_verb lexeme
  of lived_before
  language en
  pos verb
  form "live before"
  form "die before the birth of"
  frame subject object
  source "authored (commonsense-agent)"

@outlived predicate
  args subject:entity object:entity
  role subject person
  role object person
  label en "outlived"
  description "The subject died in a later year than the object. Derived from the death years (died_on)."

@lx_outlived_en_verb lexeme
  of outlived
  language en
  pos verb
  form "outlive"
  form "survive"
  frame subject object
  source "authored (commonsense-agent)"

@age_difference predicate
  args subject:entity topic:entity object:integer
  role subject person
  role topic person
  role object integer
  label en "age difference"
  description "The subject was born the given number of years before the topic person (birth year of the topic minus birth year of the subject; approximate to one year)."
  unit "years"

@age_in_year predicate
  args subject:entity time:time object:integer
  role subject person
  role time time
  role object integer
  label en "age in year"
  description "The approximate age of a person in a given year (the year minus the birth year), for the years of the person's lifetime that the memory mentions (the founding, publication or discovery years of things the person made, the death year)."
  unit "years"

# ---- family (derived from parent_of, sibling_of, married_to and gender) ------------------------------------------------------------

