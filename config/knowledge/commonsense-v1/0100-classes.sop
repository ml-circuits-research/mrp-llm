@cs_cl_r_disjoint_symmetric rule
  when disjoint_with ?a ?b
  then disjoint_with ?b ?a
  source "authored (commonsense-v1, classes): disjoint_with is symmetric"

@cs_cl_r_disjoint_no_member rule
  when is_a ?x ?a
  when disjoint_with ?a ?b
  then not is_a ?x ?b
  source "authored (commonsense-v1, classes): a member of a class cannot belong to a disjoint class"

@cs_cl_i_entity_disjoint_violation integrity
  never all
    is_a ?x ?a
    is_a ?x ?b
    disjoint_with ?a ?b
  end
  witness ?x
  message "entity is a member of two disjoint classes"
  severity warning
  source "authored (commonsense-v1, classes): no entity can belong to two disjoint classes"

@cs_cl_i_circular_is_a integrity
  never all
    is_a ?a ?b
    is_a ?b ?a
    compare ?a not_equal ?b
  end
  witness ?a
  message "class is both a subclass and superclass of another in a circular relationship"
  severity warning
  source "authored (commonsense-v1, classes): is_a cannot be circular between distinct classes"

@cs_cl_d_bird_flies default
  when is_a ?x bird
  then capable_of ?x "fly"
  source "authored (commonsense-v1, classes): birds are typically capable of flying"

@cs_cl_d_animal_moves default
  when is_a ?x animal
  then capable_of ?x "move"
  source "authored (commonsense-v1, classes): animals are typically capable of moving"

@cs_cl_d_plant_grows default
  when is_a ?x plant
  then capable_of ?x "grow"
  source "authored (commonsense-v1, classes): plants are typically capable of growing"

@cs_cl_d_food_edible default
  when is_a ?x food
  then typical_property ?x "edible"
  source "authored (commonsense-v1, classes): food typically has the property of being edible"

@cs_cl_d_plant_has_leaves default
  when is_a ?x plant
  then typically_has ?x plant_organ
  source "authored (commonsense-v1, classes): plants typically have plant organs such as leaves or roots"

@cs_cl_d_animal_has_body_parts default
  when is_a ?x animal
  then typically_has ?x body_part
  source "authored (commonsense-v1, classes): animals typically have body parts"

@cs_cl_d_inherit_capable_of default
  when is_a ?x ?c
  when capable_of ?c ?v
  then capable_of ?x ?v
  source "authored (commonsense-v1, classes; commonsense-agent): what a kind typically does, is, has or where it is found is inherited by its subclasses and members unless something says otherwise"

@cs_cl_d_inherit_used_for default
  when is_a ?x ?c
  when used_for ?c ?v
  then used_for ?x ?v
  source "authored (commonsense-v1, classes; commonsense-agent): what a kind typically does, is, has or where it is found is inherited by its subclasses and members unless something says otherwise"

@cs_cl_d_inherit_typical_property default
