# ---- Same dimension rule ----

@cs_r_same_dimension rule
  when dimension_of ?a ?d
  when dimension_of ?b ?d
  then same_dimension ?a ?b
  source "authored (commonsense-v1, units): two units with the same dimension have the same dimension"

# ---- Conversion rules (only whole-number ratios: derives converts_to from base_amount) ----

@cs_r_convert_gram_milligram rule
  when base_amount grams ?x
  when base_amount milligram ?y
  when compute ?ratio ?x divided_by ?y
  then converts_to grams milligram ?ratio
  source "authored (commonsense-v1, units): conversion factor from gram to milligram"

@cs_r_convert_kilogram_gram rule
  when base_amount kilogram ?x
  when base_amount grams ?y
  when compute ?ratio ?x divided_by ?y
  then converts_to kilogram grams ?ratio
  source "authored (commonsense-v1, units): conversion factor from kilogram to gram"

@cs_r_convert_kilogram_milligram rule
  when base_amount kilogram ?x
  when base_amount milligram ?y
  when compute ?ratio ?x divided_by ?y
  then converts_to kilogram milligram ?ratio
  source "authored (commonsense-v1, units): conversion factor from kilogram to milligram"

@cs_r_convert_tonne_kilogram rule
  when base_amount tonne ?x
  when base_amount kilogram ?y
  when compute ?ratio ?x divided_by ?y
  then converts_to tonne kilogram ?ratio
  source "authored (commonsense-v1, units): conversion factor from tonne to kilogram"

@cs_r_convert_metre_centimetre rule
  when base_amount metres ?x
  when base_amount centimetres ?y
  when compute ?ratio ?x divided_by ?y
  then converts_to metres centimetres ?ratio
  source "authored (commonsense-v1, units): conversion factor from metre to centimetre"

@cs_r_convert_metre_millimetre rule
  when base_amount metres ?x
  when base_amount millimetre ?y
  when compute ?ratio ?x divided_by ?y
  then converts_to metres millimetre ?ratio
  source "authored (commonsense-v1, units): conversion factor from metre to millimetre"

@cs_r_convert_km_metre rule
  when base_amount km ?x
  when base_amount metres ?y
  when compute ?ratio ?x divided_by ?y
  then converts_to km metres ?ratio
  source "authored (commonsense-v1, units): conversion factor from kilometre to metre"

@cs_r_convert_minute_second rule
  when base_amount minutes ?x
  when base_amount second ?y
  when compute ?ratio ?x divided_by ?y
  then converts_to minutes second ?ratio
  source "authored (commonsense-v1, units): conversion factor from minute to second"

@cs_r_convert_hour_minute rule
  when base_amount hour ?x
  when base_amount minutes ?y
  when compute ?ratio ?x divided_by ?y
  then converts_to hour minutes ?ratio
  source "authored (commonsense-v1, units): conversion factor from hour to minute"

@cs_r_convert_day_hour rule
  when base_amount day ?x
  when base_amount hour ?y
  when compute ?ratio ?x divided_by ?y
  then converts_to day hour ?ratio
  source "authored (commonsense-v1, units): conversion factor from day to hour"

@cs_r_convert_week_day rule
  when base_amount week ?x
  when base_amount day ?y
  when compute ?ratio ?x divided_by ?y
  then converts_to week day ?ratio
  source "authored (commonsense-v1, units): conversion factor from week to day"

@cs_r_convert_litre_millilitre rule
  when base_amount litre ?x
  when base_amount millilitre ?y
  when compute ?ratio ?x divided_by ?y
  then converts_to litre millilitre ?ratio
  source "authored (commonsense-v1, units): conversion factor from litre to millilitre"

@cs_r_convert_foot_inch rule
  when base_amount foot ?x
  when base_amount inch ?y
  when compute ?ratio ?x divided_by ?y
  then converts_to foot inch ?ratio
  source "authored (commonsense-v1, units): conversion factor from foot to inch"

# ---- PART 3: Functional and possession relations ----

@cs_r_teaches_at_works_at rule
  when teaches_at ?p ?s
  then works_at ?p ?s
  source "authored (commonsense-v1, functional): a teacher at a school works at that school"

@cs_d_part_of_location default
  when part_of ?a ?b
  when located_in ?b ?c
  then located_in ?a ?c
  source "authored (commonsense-v1, functional): a part of a located entity is located in the same place"

@cs_d_material_inheritance default
  when is_a ?x ?class
  when made_of_material ?class ?mat
  then made_of_material ?x ?mat
  source "authored (commonsense-v1, functional): substances inherit material composition from their class"

