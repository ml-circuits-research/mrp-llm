# commonsense-v1: units-functional (rules, defaults, integrity and facts written by a Claude Haiku subagent of commonsense-agent from its skeleton, 2026-10-02; reviewed and corrected by commonsense-agent; mechanically validated by tools/commonsense/check.mjs).
# Part 1: unit entities (missing common units from core-en), Part 2: unit facts and conversion rules,
# Part 3: functional/possession relation defaults

# ---- PART 1: Missing common unit entities ----

@cs_u_pound entity
  kind unit
  label en "pound"
  alias en "lb"
  alias en "lbs"
  alias en "pounds"
  source "authored (commonsense-v1, units): common imperial mass unit"

@cs_u_ounce entity
  kind unit
  label en "ounce"
  alias en "oz"
  alias en "ozs"
  alias en "ounces"
  source "authored (commonsense-v1, units): common imperial mass unit"

@cs_u_yard entity
  kind unit
  label en "yard"
  alias en "yd"
  alias en "yards"
  source "authored (commonsense-v1, units): common imperial length unit"

@cs_u_us_gallon entity
  kind unit
  label en "gallon"
  alias en "gal"
  alias en "gallons"
  alias en "US gallon"
  source "authored (commonsense-v1, units): common US volume unit"

@cs_u_pint entity
  kind unit
  label en "pint"
  alias en "pt"
  alias en "pts"
  alias en "pints"
  source "authored (commonsense-v1, units): US liquid volume unit (472.176 millilitres)"

@cs_u_hectare entity
  kind unit
  label en "hectare"
  alias en "ha"
  alias en "hectares"
  source "authored (commonsense-v1, units): metric land area unit (10,000 square metres)"

@cs_u_acre entity
  kind unit
  label en "acre"
  alias en "acres"
  source "authored (commonsense-v1, units): imperial land area unit"

@cs_u_square_foot entity
  kind unit
  label en "square foot"
  alias en "sq ft"
  alias en "ft2"
  alias en "ft²"
  alias en "square feet"
  source "authored (commonsense-v1, units): imperial area unit"

