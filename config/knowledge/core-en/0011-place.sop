@located_in predicate
  args subject:entity location:entity
  role subject entity
  role location place
  label en "located in"
  description "An entity is located in a place; the containment may be administrative or geographic."
  reading location

@headquartered_in predicate
  args subject:entity location:entity
  role subject organization
  role location place
  label en "headquartered in"
  description "An organization has its headquarters in a place."

@part_of predicate
  args subject:entity object:entity
  role subject entity
  role object entity
  label en "part of"
  description "An entity is a meronymic part or component of another entity."

@capital_of predicate
  args subject:entity object:entity
  role subject city
  role object country
  label en "capital of"
  description "A city is the capital of a country or other administrative territory."

@borders predicate
  args subject:entity object:entity
  role subject country
  role object country
  label en "borders"
  description "Two countries or equal-level territories share a border; the relation is symmetric."

@near predicate
  args subject:entity object:entity
  role subject entity
  role object entity
  label en "near"
  description "Two entities are spatially close to each other; the relation is symmetric."

@address_of predicate
  args subject:entity object:text
  role subject entity
  role object text
  label en "address"
  description "An entity is located at a textual street or postal address."

@official_language_of predicate
  args subject:entity object:entity
  role subject language
  role object country
  label en "official language of"
  description "A language is an official language of a country or territory."

@uses_currency predicate
  args subject:entity object:entity
  role subject country
  role object currency
  label en "uses currency"
  description "A country uses a currency as its monetary unit."

@head_of_state_of predicate
  args subject:entity object:entity
  role subject person
  role object country
  label en "head of state of"
  description "A person is the head of state of a country."

@head_of_government_of predicate
  args subject:entity object:entity
  role subject person
  role object country
  label en "head of government of"
  description "A person is the head of government of a country, such as a prime minister."

@contains predicate
  args subject:entity object:entity
  role subject place
  role object entity
  label en "contains"
  description "A place spatially contains an entity; the converse of located_in."

