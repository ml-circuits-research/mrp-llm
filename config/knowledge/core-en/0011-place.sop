@r_located_in_transitive rule
  when located_in ?x ?y
  when located_in ?y ?z
  then located_in ?x ?z
  source "authored"

@r_contains_transitive rule
  when contains ?x ?y
  when contains ?y ?z
  then contains ?x ?z
  source "authored"

@r_located_in_to_contains rule
  when located_in ?x ?y
  then contains ?y ?x
  source "authored"

@r_contains_to_located_in rule
  when contains ?y ?x
  then located_in ?x ?y
  source "authored"

@r_part_of_transitive rule
  when part_of ?x ?y
  when part_of ?y ?z
  then part_of ?x ?z
  source "authored"

@r_borders_symmetric rule
  when borders ?a ?b
  then borders ?b ?a
  source "authored"

@r_near_symmetric rule
  when near ?a ?b
  then near ?b ?a
  source "authored"

@r_capital_located_in rule
  when capital_of ?city ?country
  then located_in ?city ?country
  source "authored"

@r_headquartered_located_in rule
  when headquartered_in ?org ?place
  then located_in ?org ?place
  source "authored"

