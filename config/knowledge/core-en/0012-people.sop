@r_mother_is_parent rule
  when mother_of ?a ?b
  then parent_of ?a ?b
  source "authored"

@r_father_is_parent rule
  when father_of ?a ?b
  then parent_of ?a ?b
  source "authored"

@r_parent_child rule
  when parent_of ?a ?b
  then child_of ?b ?a
  source "authored"

@r_child_parent rule
  when child_of ?a ?b
  then parent_of ?b ?a
  source "authored"

@r_grandparent rule
  when parent_of ?a ?b
  when parent_of ?b ?c
  then grandparent_of ?a ?c
  source "authored"

@r_ancestor_base rule
  when parent_of ?a ?b
  then ancestor_of ?a ?b
  source "authored"

@r_ancestor_trans rule
  when ancestor_of ?a ?b
  when ancestor_of ?b ?c
  then ancestor_of ?a ?c
  source "authored"

@r_sibling_shared_parent rule
  when parent_of ?p ?a
  when parent_of ?p ?b
  when compare ?a not_equal ?b
  then sibling_of ?a ?b
  source "authored; guard against the self-pair sibling_of ?a ?a added by commonsense-agent 2026-10-02"

@r_sibling_sym rule
  when sibling_of ?a ?b
  then sibling_of ?b ?a
  source "authored"

@r_married_sym rule
  when married_to ?a ?b
  then married_to ?b ?a
  source "authored"

@r_friend_sym rule
  when friend_of ?a ?b
  then friend_of ?b ?a
  source "authored"

@r_cousin_sym rule
  when cousin_of ?a ?b
  then cousin_of ?b ?a
  source "authored"

@r_relative_sym rule
  when relative_of ?a ?b
  then relative_of ?b ?a
  source "authored"

@r_colleague_sym rule
  when colleague_of ?a ?b
  then colleague_of ?b ?a
  source "authored"

@r_neighbor_sym rule
  when neighbor_of ?a ?b
  then neighbor_of ?b ?a
  source "authored"

@r_partner_sym rule
  when partner_of ?a ?b
  then partner_of ?b ?a
  source "authored"

@r_gender_without_object rule
  when gender ?subject ?object
  then gender_without_object ?subject
  source "generated: a variant relation implies its projection"

