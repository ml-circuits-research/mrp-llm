@r_head_of_manages rule
  when head_of ?p ?o
  then manages ?p ?o
  source "authored"

@r_plays_for_member rule
  when plays_for ?p ?t
  then member_of ?p ?t
  source "authored"

@r_sings_in_member rule
  when sings_in ?p ?t
  then member_of ?p ?t
  source "authored"

@r_cooks_at_works_at rule
  when cooks_at ?p ?o
  then works_at ?p ?o
  source "authored"

@r_hires_works_at rule
  when hires ?o ?p
  then works_at ?p ?o
  source "authored"

@r_resigns_without_source rule
  when resigns ?subject ?source
  then resigns_without_source ?subject
  source "generated: a variant relation implies its projection"

