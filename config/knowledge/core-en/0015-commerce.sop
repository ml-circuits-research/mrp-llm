@r_owns_implies_has rule
  when owns ?a ?b
  then has ?a ?b
  source "authored"

@r_sells_with_recipient rule
  when sells_with_recipient ?subject ?object ?recipient
  then sells ?subject ?object
  source "generated: a variant relation implies its projection"

@r_buys_from_without_object rule
  when buys_from ?subject ?source ?object
  then buys_from_without_object ?subject ?source
  source "generated: a variant relation implies its projection"

@r_borrows_with_source rule
  when borrows_with_source ?subject ?object ?source
  then borrows ?subject ?object
  source "generated: a variant relation implies its projection"

@r_sends_without_recipient rule
  when sends ?subject ?object ?recipient
  then sends_without_recipient ?subject ?object
  source "generated: a variant relation implies its projection"

@r_sends_without_subject rule
  when sends ?subject ?object ?recipient
  then sends_without_subject ?object ?recipient
  source "generated: a variant relation implies its projection"

@r_gives_without_recipient rule
  when gives ?subject ?object ?recipient
  then gives_without_recipient ?subject ?object
  source "generated: a variant relation implies its projection"

@r_gives_without_subject rule
  when gives ?subject ?object ?recipient
  then gives_without_subject ?object ?recipient
  source "generated: a variant relation implies its projection"

@r_receives_with_source rule
  when receives_with_source ?subject ?object ?source
  then receives ?subject ?object
  source "generated: a variant relation implies its projection"

@r_orders_with_source rule
  when orders_with_source ?subject ?object ?source
  then orders ?subject ?object
  source "generated: a variant relation implies its projection"

@r_repairs_without_subject rule
  when repairs ?subject ?object
  then repairs_without_subject ?object
  source "generated: a variant relation implies its projection"

