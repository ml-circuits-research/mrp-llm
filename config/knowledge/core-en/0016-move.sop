@r_before_after rule
  when before ?a ?b
  then after ?b ?a
  source "authored"

@r_after_before rule
  when after ?a ?b
  then before ?b ?a
  source "authored"

@r_distance_symmetric rule
  when distance_between ?a ?b
  then distance_between ?b ?a
  source "authored"

@r_arrives_at_without_destination rule
  when arrives_at ?subject ?destination
  then arrives_at_without_destination ?subject
  source "generated: a variant relation implies its projection"

@r_leaves_without_source rule
  when leaves ?subject ?source
  then leaves_without_source ?subject
  source "generated: a variant relation implies its projection"

@r_moves_to_without_source rule
  when moves_to ?subject ?destination ?source
  then moves_to_without_source ?subject ?destination
  source "generated: a variant relation implies its projection"

@r_moves_to_without_destination rule
  when moves_to ?subject ?destination ?source
  then moves_to_without_destination ?subject ?source
  source "generated: a variant relation implies its projection"

@r_commutes_by_without_instrument rule
  when commutes_by ?subject ?instrument
  then commutes_by_without_instrument ?subject
  source "generated: a variant relation implies its projection"

@r_starts_at_without_time rule
  when starts_at ?subject ?time
  then starts_at_without_time ?subject
  source "generated: a variant relation implies its projection"

@r_ends_at_without_time rule
