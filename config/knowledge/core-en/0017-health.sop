@r_outage_cause rule
  when caused_outage ?a ?b
  then out_of_service ?b
  source "authored"

@r_postponed_cause rule
  when postponed_because_of ?e ?x
  then postponed ?e
  source "authored"

@r_closed_cause rule
  when closed_for ?p ?x
  then is_closed ?p
  source "authored"

@r_sick_source rule
  when sick_from ?p ?x
  then ill ?p
  source "authored"

@r_flu_vaccinated rule
  when vaccinated_against ?p flu
  then vaccinated ?p
  source "authored"

