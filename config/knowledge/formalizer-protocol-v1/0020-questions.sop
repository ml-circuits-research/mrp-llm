@fp_pq72 fact
  holds fp_unknown unknown_v
@fp_pq73 fact
  holds fp_unknown_text unknown_v "V: the value to compare or rank (highest, lowest, before, more than another)"
@fp_pq74 fact
  holds fp_unknown unknown_w
@fp_pq75 fact
  holds fp_unknown_text unknown_w "W: a value the request limits (more than a number, between two numbers, before a year)"
@fp_pq76 fact
  holds fp_unknown unknown_p
@fp_pq77 fact
  holds fp_unknown_text unknown_p "P: another unknown thing (the same P in every statement)"
@fp_pq78 fact
  holds fp_unknown unknown_q
@fp_pq79 fact
  holds fp_unknown_text unknown_q "Q: a second other unknown thing (the same Q in every statement)"

