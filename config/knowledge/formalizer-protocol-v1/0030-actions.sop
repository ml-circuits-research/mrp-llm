@fp_askable_assemble rule
  when fp_circuit_complete
  when absent fp_assembled
  when absent fp_assembly_failed
  then fp_askable assemble none

@fp_assemble action
  params ?a
  requires fp_askable assemble ?a
  adds fp_answered assemble ?a
  adds fp_assembled
  cost 0

@fp_askable_ask_places_again_asked_not_placed rule
  when violation fp_asked_not_placed ?qq
  when fp_main_instance ?qq ?i
  when absent fp_reasked ?i
  when fp_budget_left
  then fp_askable ask_places_again ?i

@fp_askable_ask_places_again_name_in_number_place rule
  when violation fp_name_in_number_place ?i
  when absent fp_reasked ?i
  when fp_budget_left
  then fp_askable ask_places_again ?i

@fp_askable_ask_places_again_number_in_name_place rule
  when violation fp_number_in_name_place ?i
  when absent fp_reasked ?i
  when fp_budget_left
  then fp_askable ask_places_again ?i

