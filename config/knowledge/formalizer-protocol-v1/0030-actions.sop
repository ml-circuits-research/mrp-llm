  when absent fp_reasked ?i
  when fp_budget_left
  then fp_askable ask_places_again ?i

@fp_askable_ask_places_again_v_not_placed rule
  when violation fp_v_not_placed ?qq
  when fp_number_instance ?qq ?i
  when absent fp_reasked ?i
  when fp_budget_left
  then fp_askable ask_places_again ?i

@fp_askable_ask_places_again_validator rule
  when fp_repair_target ?qq ?i
  when fp_assembly_failed
  when fp_repairs_left
  when absent fp_reasked ?i
  when fp_budget_left
  then fp_askable ask_places_again ?i

@fp_askable_ask_places_again_doubt rule
  when fp_doubt places
  when fp_uses q ?i
  when fp_budget_ample
  when absent fp_reasked ?i
  when fp_budget_left
  then fp_askable ask_places_again ?i

@fp_ask_places_again action
  params ?a
  requires fp_askable ask_places_again ?a
  adds fp_answered ask_places_again ?a
  adds fp_reasked ?a
  removes fp_assembly_failed
  removes fp_assembled
  removes fp_contrast_available
  cost 2

# The goal of every decision.
@fp_formalized_goal goal
  where fp_formalized
