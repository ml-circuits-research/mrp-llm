# formalizer-protocol-v1: early exits (DS022 "InternalReasoningStepByStep"). A default settles a slot without a question when the
# observations of the request leave one reading; its exceptions name what makes the reading doubtful, and then the question is asked.
# Every default that fires is reported in the trace as a question avoided.

# A mention with exactly one candidate in the memory means that candidate.
@fp_d_single_candidate default
  when fp_mention_candidate ?m ?n
  when fp_single_candidate ?m
  then fp_linked ?m ?n

# Exactly two names and a choice between named things: the two names are the options.
@fp_d_two_options default
  when fp_has_aspect options
  when fp_exactly_two_names
  when fp_name_in_request ?n
  then fp_option_name ?n

# A name the memory records in exactly one place of a used statement goes into that place (unless two names claim it, or a yes/no
# question has more names than the statement has places).
@fp_d_observed_place default
  when fp_claim ?i ?r ?n
  then fp_place ?i ?r ?n
  except fp_contested ?i ?r
  except fp_crowded_yesno ?i

# A yes/no or why question about one statement with one place and one name: the name is in that place.
@fp_d_single_name_yesno default
  when fp_uses ?qq ?i
  when fp_query_kind ?qq ?k
  when fp_yes_like_kind ?k
  when fp_instance_of ?i ?s
  when fp_statement_arity ?s 1
  when fp_statement_role ?s ?r ?t
  when fp_place_name ?qq ?n
  then fp_place ?i ?r ?n
  except fp_instance_pair ?qq
  except fp_two_place_names ?qq
  except fp_misfit ?n ?s ?r

# A question that asks for something, one statement with one place and no name: the place is the asked unknown.
@fp_d_asked_single default
  when fp_uses ?qq ?i
  when fp_query_kind ?qq ?k
  when fp_asking_kind ?k
  when fp_instance_of ?i ?s
  when fp_statement_arity ?s 1
  when fp_statement_role ?s ?r ?t
  then fp_place ?i ?r unknown_x
  except fp_instance_pair ?qq
  except fp_has_place_name ?qq

@fp_d_member_single default
  when fp_uses ?qq ?i
  when fp_query_kind ?qq every
  when fp_instance_of ?i ?s
  when fp_statement_arity ?s 1
  when fp_statement_role ?s ?r ?t
  then fp_place ?i ?r unknown_m
  except fp_instance_pair ?qq
  except fp_has_place_name ?qq

# Without a negation in the request and without a complete statement, a yes/no question asks whether it is true.
@fp_d_affirmed default
  when fp_query_kind ?qq ?k
  when fp_yes_like_kind ?k
  when fp_places_done ?qq
  then fp_polarity ?qq affirmed
  except fp_truth_doubtful ?qq

# A clause whose content words name exactly one statement says that statement.
@fp_d_clause_single_hit default
  when fp_statement_clause ?c
  when fp_clause_single_hit ?c ?s
  then fp_clause_pick ?c ?s

# A clause without a name of its own is about the one name of the request.
@fp_d_clause_single_name default
  when fp_statement_clause ?c
  when fp_name_in_request ?n
  then fp_clause_name ?c ?n
  except fp_two_names
  except fp_clause_has_own ?c

@fp_d_question_clause_single_name default
  when fp_clause_kind_query ?c
  when fp_name_in_request ?n
  then fp_clause_name ?c ?n
  except fp_two_names
  except fp_clause_has_own ?c

# The words of the supposition name exactly one statement of one thing: the chain avoids the things of which it holds.
@fp_d_avoid_hint default
  when fp_query_kind q reach
  when fp_avoid_hint ?c ?s
  then fp_reach_avoid q ?s

# Without a forced contrast to ask (no alternative reading, or no budget left), the assembled reading stands.
@fp_d_confirmed default
  when fp_assembled
  then fp_confirmed
  except fp_contrast_wanted
  except fp_wrong_part_wanted
