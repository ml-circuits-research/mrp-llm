# Hand-written SOP of documents/hx200-pump-manual.md.

@may_run_dry predicate
  args subject:entity
  label en "may run dry"

@hx_weight fact
  holds amount pump_weight 18
  quote "Weight: 18 kg."
  source "hx200-pump-manual.md, line 5"
@hx_weight_unit fact
  holds unit_of pump_weight kg
  quote "Weight: 18 kg."
  source "hx200-pump-manual.md, line 5"
@hx_limit fact
  holds upper_limit operating_pressure 10
  quote "Maximum operating pressure: 10 bar. Never operate the pump above this pressure."
  source "hx200-pump-manual.md, line 6"
@hx_eff fact
  holds amount hydraulic_efficiency 112
  quote "Hydraulic efficiency: 112% at the nominal point."
  source "hx200-pump-manual.md, line 7"
@hx_eff_unit fact
  holds unit_of hydraulic_efficiency percent
  quote "Hydraulic efficiency: 112% at the nominal point."
  source "hx200-pump-manual.md, line 7"
@hx_eff_kind fact
  holds measure_of hydraulic_efficiency percentage
  quote "Hydraulic efficiency: 112% at the nominal point."
  source "hx200-pump-manual.md, line 7"
@hx_power fact
  holds amount power_draw 1.5
  quote "Total electrical power draw: 1.5 kW"
  source "hx200-pump-manual.md, line 8"
@hx_power_unit fact
  holds unit_of power_draw kw
  quote "Total electrical power draw: 1.5 kW"
  source "hx200-pump-manual.md, line 8"
@hx_power_split fact
  holds breakdown_complete power_draw
  quote "made up of the motor (1.2 kW) and the controller (0.3 kW)"
  source "hx200-pump-manual.md, line 8"
@hx_motor_part fact
  holds component_of motor_power power_draw
  quote "the motor (1.2 kW)"
  source "hx200-pump-manual.md, line 8"
@hx_motor fact
  holds amount motor_power 1.2
  quote "the motor (1.2 kW)"
  source "hx200-pump-manual.md, line 8"
@hx_motor_unit fact
  holds unit_of motor_power kw
  quote "the motor (1.2 kW)"
  source "hx200-pump-manual.md, line 8"
@hx_ctrl_part fact
  holds component_of controller_power power_draw
  quote "the controller (0.3 kW)"
  source "hx200-pump-manual.md, line 8"
@hx_ctrl fact
  holds amount controller_power 0.3
  quote "the controller (0.3 kW)"
  source "hx200-pump-manual.md, line 8"
@hx_ctrl_unit fact
  holds unit_of controller_power kw
  quote "the controller (0.3 kW)"
  source "hx200-pump-manual.md, line 8"

@hx_continuous fact
  holds amount operating_pressure 12
  quote "The HX-200 is rated for continuous operation at 12 bar."
  source "hx200-pump-manual.md, line 12"
@hx_pressure_unit fact
  holds unit_of operating_pressure bar
  quote "The HX-200 is rated for continuous operation at 12 bar."
  source "hx200-pump-manual.md, line 12"
@hx_never_dry fact
  holds not may_run_dry hx200
  quote "The pump must never run dry."
  source "hx200-pump-manual.md, line 13"
@hx_dry_commissioning fact
  holds may_run_dry hx200
  quote "During commissioning the pump may run dry for up to 5 minutes."
  source "hx200-pump-manual.md, line 14"
@hx_weight_transport fact
  holds amount pump_weight 21
  quote "The pump weighs 21 kg and must be lifted by two persons."
  source "hx200-pump-manual.md, line 18"
