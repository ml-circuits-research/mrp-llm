@parent predicate
  args subject:entity object:entity
@grandparent predicate
  args subject:entity object:entity
@great_grandparent predicate
  args subject:entity object:entity

@f1 fact
  holds parent ann bob
@f2 fact
  holds parent bob cy
@f3 fact
  holds parent cy di

@r_grand rule
  when parent ?x ?y
  when parent ?y ?z
  then grandparent ?x ?z

@r_great rule
  when parent ?x ?y
  when grandparent ?y ?z
  then great_grandparent ?x ?z
