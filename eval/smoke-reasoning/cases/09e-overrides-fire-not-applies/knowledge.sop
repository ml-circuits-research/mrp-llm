@pacifist predicate
  args subject:entity
@quaker predicate
  args subject:entity
@republican predicate
  args subject:entity
@exempt predicate
  args subject:entity

@f1 fact
  holds quaker nixon
@f2 fact
  holds republican nixon
@f3 fact
  holds exempt nixon

@d_quaker default
  when quaker ?x
  then pacifist ?x

@d_republican default
  when republican ?x
  then not pacifist ?x
  except exempt ?x
  overrides $d_quaker
