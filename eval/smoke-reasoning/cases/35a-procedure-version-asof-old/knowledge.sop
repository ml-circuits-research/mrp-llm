@router predicate
  args subject:entity
@router_reset predicate
  args subject:entity
@notified predicate
  args subject:entity
@reset_done predicate
  args subject:entity
@link_up predicate
  args subject:entity
@business_hours predicate
  args none
@emergency predicate
  args subject:entity
@ticket_open predicate
  args subject:entity
  closed true

@notify_oncall action
  params ?r
  requires router ?r
  adds notified ?r
  cost 1
@soft_reset action
  params ?r
  requires router ?r
  requires notified ?r
  adds reset_done ?r
  cost 3
@hard_reset action
  params ?r
  requires router ?r
  adds reset_done ?r
  cost 1
@verify_link action
  params ?r
  requires reset_done ?r
  adds link_up ?r
  adds router_reset ?r
  cost 1

@reset_router_v1 method
  achieves router_reset ?r
  when router ?r
  version 1
  approval superseded
  approved_by "ops lead"
  approved_at 2025-03-01
  step ~hard_reset ?r
  step ~verify_link ?r

@reset_router method
  achieves router_reset ?r
  when router ?r
  version 2
  supersedes $reset_router_v1
  approval approved
  approved_by "ops lead"
  approved_at 2026-09-30
  source "Ops manual 4.2"
  binding strict
  step ~notify_oncall ?r
  step choose
    ~soft_reset ?r
    ~hard_reset ?r
  end
  step ~verify_link ?r

@reset_router_v3 method
  achieves router_reset ?r
  when router ?r
  version 3
  supersedes $reset_router
  approval proposed
  step ~notify_oncall ?r
  step ~hard_reset ?r
  step ~verify_link ?r
