@payroll aggregate
  over salary ?p ?d ?s
  group ?d
  sum ?s as ?t
  yields dept_payroll ?d ?t

@headcount aggregate
  over salary ?p ?d ?s
  group ?d
  count as ?n
  yields dept_size ?d ?n

@best aggregate
  over salary ?p ?d ?s
  group ?d
  max ?s as ?m
  yields top_salary ?d ?m

@r_avg rule
  when dept_payroll ?d ?t
  when dept_size ?d ?n
  when compute ?a ?t whole_divided_by ?n
  then avg_salary ?d ?a

@r_gap rule
  when top_salary ?d ?m
  when avg_salary ?d ?a
  when compute ?g ?m minus ?a
  then gap ?d ?g
