@edge predicate
  args source:entity destination:entity
@reach predicate
  args source:entity destination:entity

@e1 fact
  holds edge a b
@e2 fact
  holds edge b c
@e3 fact
  holds edge c a
@e4 fact
  holds edge c d
@e5 fact
  holds edge d e
@e6 fact
  holds edge e d
@e7 fact
  holds edge f a

@r_base rule
  when edge ?x ?y
  then reach ?x ?y

@r_left rule
  when reach ?x ?m
  when edge ?m ?y
  then reach ?x ?y
