@normal predicate
  args none
@service predicate
  args none
@state predicate
  args subject:entity topic:entity object:rational

@m0 fact
  holds normal

@s_q fact
  holds state demo q 0

@s_a0 fact
  holds state demo a0 1

@s_b0 fact
  holds state demo b0 2

@s_a1 fact
  holds state demo a1 2

@s_b1 fact
  holds state demo b1 3

@s_a2 fact
  holds state demo a2 3

@s_b2 fact
  holds state demo b2 1

@a0_normal action
  requires normal
  guard ?q below 1000000000
  next q ?q + ?a0 * ?b0
  next a0 2 * ?a0
  next b0 1/2 * ?b0
  next a1 1/2 * ?a1
  next b1 2 * ?b1
  next a2 ?b2
  next b2 ?a2

@a0_service action
  requires service
  removes service
  adds normal
  guard ?q below 1000000000
  next q ?q + ?a0 * ?b0
  next a0 2 * ?a0
  next b0 1/2 * ?b0
  next a1 1/2 * ?a1
  next b1 2 * ?b1
  next a2 ?b2
  next b2 ?a2

@a1_normal action
  requires normal
  guard ?q below 1000000000
  next q ?q + ?a1 * ?b1
  next a0 -1 * ?a0
  next b0 -1 * ?b0
  next a1 2 * ?a1
  next b1 1/2 * ?b1
  next a2 1/2 * ?a2
  next b2 2 * ?b2

@a1_service action
  requires service
  guard ?q below 1000000000
  next q ?q + ?a1 * ?b1
  next a0 -1 * ?a0
  next b0 -1 * ?b0
  next a1 2 * ?a1
  next b1 1/2 * ?b1
  next a2 1/2 * ?a2
  next b2 2 * ?b2

@a2_normal action
  requires normal
  removes normal
  adds service
  guard ?q below 1000000000
  next q ?q + ?a2 * ?b2
  next a0 ?b0
  next b0 ?a0
  next a1 -1 * ?a1
  next b1 -1 * ?b1
  next a2 2 * ?a2
  next b2 1/2 * ?b2

@a2_service action
  requires service
  guard ?q below 1000000000
  next q ?q + ?a2 * ?b2
  next a0 ?b0
  next b0 ?a0
  next a1 -1 * ?a1
  next b1 -1 * ?b1
  next a2 2 * ?a2
  next b2 1/2 * ?b2

@a3_normal action
  requires normal
  guard ?q below 1000000000
  next q ?q + 0
  next a0 1/2 * ?a0
  next b0 2 * ?b0
  next a1 ?b1
  next b1 ?a1
  next a2 -1 * ?a2
  next b2 -1 * ?b2

@a3_service action
  requires service
  removes service
  adds normal
  guard ?q below 1000000000
  next q ?q + 0
  next a0 1/2 * ?a0
  next b0 2 * ?b0
  next a1 ?b1
  next b1 ?a1
  next a2 -1 * ?a2
  next b2 -1 * ?b2
