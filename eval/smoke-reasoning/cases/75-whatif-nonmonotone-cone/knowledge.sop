@r_flag rule
  when contains ?s ?i
  when dangerous ?i
  then flagged ?s
@r_clear rule
  when shipment ?s
  when absent flagged ?s
  then clear ?s
@r_ship rule
  when clear ?s
  when paid ?s
  then shippable ?s
