@shipment predicate
  args subject:entity
@paid predicate
  args subject:entity
@contains predicate
  args subject:entity object:entity
@dangerous predicate
  args subject:entity
@flagged predicate
  args subject:entity
  closed true
@clear predicate
  args subject:entity
  closed true
@shippable predicate
  args subject:entity

@sh0 fact
  holds shipment s0
@pd0 fact
  holds paid s0
@ct0 fact
  holds contains s0 i0
@cu0 fact
  holds contains s0 extra0
