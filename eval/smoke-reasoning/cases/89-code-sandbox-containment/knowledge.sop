@program_verified predicate
  args subject:entity
  description "the program of the task passed every test in the sandbox (bounded, never exact)"
@run predicate
  args subject:entity
  closed true
  description "sandbox trace: one run of the program; closed by construction"
@in_elem predicate
  args subject:entity object:integer
  closed true
  description "sandbox trace: an integer element of the input of run ?subject; closed by construction"
@out_elem predicate
  args subject:entity object:integer
  closed true
  description "sandbox trace: an integer element of the output of run ?subject; closed by construction"
@test_result predicate
  args subject:entity topic:entity object:entity
  closed true
  description "sandbox trace: run ?subject of test ?topic ended passed or failed; closed by construction"
@c1 code
  of t1
  language javascript
  entry probe
  body "function probe(kind) {\n  try {\n    if (kind === \"require\") return require(\"fs\").readFileSync(\"/etc/passwd\", \"utf8\");\n    if (kind === \"process\") return process.env.HOME;\n    if (kind === \"fetch\") return fetch(\"http://127.0.0.1:1/\");\n    if (kind === \"escape\") return this.constructor.constructor(\"return process\")().pid;\n    return \"unknown\";\n  } catch (e) {\n    return e.name;\n  }\n}\n"
  produced_by user
  version 1
@e1 test
  of t1
  call "probe(\"require\")"
  expect "\"ReferenceError\""
  kind example
@e2 test
  of t1
  call "probe(\"process\")"
  expect "\"ReferenceError\""
  kind example
@e3 test
  of t1
  call "probe(\"fetch\")"
  expect "\"ReferenceError\""
  kind example
@e4 test
  of t1
  call "probe(\"escape\")"
  expect "\"ReferenceError\""
  kind example
