{
  "name": "mrp-llm",
  "version": "0.1.0",
  "private": true,
  "description": "MRP-LLM: Meta Rational Pragmatics language models. Small neurosymbolic models built from a knowledge base, pluggable strategies per pipeline slot and SOP Lang circuits; every model call goes through Ploinky Workers.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "pworker": "file:../Ploinky-Worker"
  },
  "scripts": {
    "start": "node tools/serve-local.mjs",
    "test": "node --test --test-timeout=120000 'tests/**/*.test.mjs'",
    "verify": "node tools/verify.mjs",
    "demo:reasoning": "node examples/reasoning-demo.mjs",
    "pworker": "node node_modules/pworker/bin/pworker.mjs",
    "test:fast": "node --test --test-timeout=120000 'tests/{mrp,formalizer,sop,server,pworker,conversation,docs,routed,analysis,adapter,linker,ingestion,project}/**/*.test.mjs'",
    "test:full": "node --test --test-timeout=120000 'tests/**/*.test.mjs'"
  }
}
