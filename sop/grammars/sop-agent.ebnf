(* Envelope reference for the SOP grammar (trusted circuits and the model language).
   sop/parser.mjs + sop/lower.mjs are normative.
   This file is documentation, NOT a llama.cpp GBNF decoding guarantee. *)
program = wire, { newline, wire } ;
wire = "@", identifier, space, wire_type, newline, field, { field } ;
field = "  ", field_name, [ space, scalar_or_expression ], newline
      | "  ", field_name, " |", newline, indented_body
      | "  ", condition_field, space, condition_group ;
indented_body = "    ", line, newline, { "    ", line, newline } ;
value_reference = "$", identifier ;
definition_handle = "~", identifier ;
logic_variable = "?", identifier ;
output_field = "  output ?", identifier, [ " ", output_mode ], newline ;
output_mode = "one" | "many" | "rows" | "count" | "status" ;
atom = [ "not", whitespace ], predicate_id, whitespace, term, { whitespace, term } ;
(* Atoms have 1..4 terms. not is reserved. Quoted JSON strings preserve spaces,
   commas and parentheses as data; adjacent tokens require separating whitespace.
   Parenthesized predicate(arg, ...) notation is not accepted. *)
term = canonical_id | quoted_string | safe_integer | value_reference | logic_variable ;
condition_field = "where" | "filter" | "require" | "claim" ;
condition_group = ("all" | "any"), newline, condition_line, { condition_line }, indentation, "end", newline ;
condition_line = indentation, (atom | boolean_expression), newline
               | indentation, condition_group ;
(* Groups apply to query.where/filter and constraint.require/claim only.
   Nested indentation is advisory; end closes the nearest group. Groups are
   nonempty, with at most 32 nested groups. Repeated fields remain implicit ALL. *)
model_wire_type = "stated" | "assumed" | "unclear" | "query" | "constraint" ;   (* the model language *)
(* Model-language propositions are context-free strings (DS014). *)
proposition_line = "  relation ", quoted_string, newline
                 | "  role ", role_name, space, (quoted_string | safe_integer), newline
                 | "  polarity ", ("affirmed" | "negated"), newline
                 | "  valid ", ("on" | "from" | "until"), space, quoted_string, newline ;
role_name = "subject" | "object" | "recipient" | "location" | "source"
          | "destination" | "instrument" | "time" | "topic" ;
stated_extra = "  certainty ", ("asserted" | "hedged" | "supposed"), newline
             | "  speaker ", ("user" | quoted_string), newline ;
assumed_extra = "  basis ", ("closure" | "default" | "disambiguation" | "implicature" | "world"), newline ;
unclear_field = "  kind ", ("gibberish" | "no_request"), newline | "  language ", ("en" | "ro"), newline ;
match_block = "match", newline, match_line, { match_line }, indentation, "end", newline ;
match_line = indentation, ( "relation ", quoted_string | "role ", role_name, " ", (quoted_string | safe_integer | logic_variable) | "polarity ", ("affirmed" | "negated") ), newline ;
(* In model output every query where-leaf is a match_block and at/during/asof take a quoted
   temporal expression; the host links phrases, roles, values and times to the lexicon. *)
wire_type = "value" | "fact" | "stated" | "assumed" | "unclear" | "rule" | "query" | "constraint" | "event"
          | "pack" | "remember" | "recall" | "link" | "solve" | "reason" | "cnl" | "jsEval"
          | "template" | "procedure" | "expand" | "clarify"
          | "pattern" | "hypothesis" | "action" | "goal" | "trace" | "policy" | "theory"
          | "abduce" | "diagnose" | "associate" | "induce" | "analogize" | "plan" | "simulate" | "temporal" ;
(* Field cardinality, permitted keys, arity, scoping, temporal validity,
   type safety, graph acyclicity and host permissions require semantic validation. *)
(* Model-origin programs use only the model wire types; sop/declarative.mjs
   links and generates their operations. Statements and assumptions are never repository
   facts. clarify is a host-generated interruption, not a model-authored declaration;
   unclear is the model's only-wire report of gibberish or no request. *)

(* `binding` is generated internally; it is not accepted as authored source.
   An exported ?name reserves a future wire consumed with $name. *)
